{
  "name": "nlpmanager",
  "version": "1.0.0",
  "description": "Desktop UI for MedScan NLP management",
  "main": "src/main/main.js",
  "scripts": {
    "start:built": "node scripts/start-built.js",
    "start": "electron --js-flags=\"--max-old-space-size=8192\" .",
    "dev": "concurrently --kill-others-on-fail \"cross-env NODE_ENV=development npm run vite\" \"wait-on http-get://127.0.0.1:5173 && cross-env NODE_ENV=development electron --js-flags=\\\"--max-old-space-size=8192\\\" .\"",
    "vite": "vite",
    "build": "node scripts/prepare-llm.js && vite build && electron-builder",
    "db:migrate": "node db/migrate.js",
    "build:llm": "node scripts/prepare-llm.js --rebuild"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "exceljs": "^3.4.0",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.11.3",
    "pluralize": "^8.0.0",
    "wink-lemmatizer": "^3.0.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.elsevier.nlpmanager",
    "productName": "NLPmanager",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "db/**/*",
      "index.html",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../conceptscan_llm/dist",
        "to": "conceptscan_llm/dist",
        "filter": [
          "**/*",
          "!*.stamp.json"
        ]
      }
    ]
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "esbuild@0.21.5": true,
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true
  }
}
